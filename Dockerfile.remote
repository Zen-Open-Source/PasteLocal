FROM golang:1.23-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /pastelocal-remote ./cmd/pastelocal-remote

FROM alpine:3.20

RUN apk add --no-cache ca-certificates
COPY --from=builder /pastelocal-remote /usr/local/bin/pastelocal-remote

ENTRYPOINT ["pastelocal-remote"]
